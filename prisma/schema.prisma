generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  professional
  client
}

enum Gender {
  male
  female
  other
  prefer_not_to_say
}

model User {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String    @db.VarChar(100)
  email             String    @unique @db.VarChar(255)
  passwordHash      String    @map("password_hash") @db.VarChar(255)
  role              UserRole  @default(client)
  phone             String?   @db.VarChar(20)
  gender            Gender?
  emailVerified     Boolean   @default(false) @map("email_verified")
  active            Boolean   @default(true)
  refreshToken      String?   @map("refresh_token") @db.Text
  profileComplete   Boolean   @default(false) @map("profile_complete")
  verificationToken String?   @map("verification_token") @db.VarChar(255)
  // RF-06.01 — fecha en que aceptó Términos de Servicio y Política de Privacidad.
  // Se (re)graba tanto al registrarse como al confirmar una reserva, para cubrir
  // también cuentas creadas antes de que este requisito existiera.
  termsAcceptedAt   DateTime? @map("terms_accepted_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  client       Client?
  professional    Professional?
  invitationsSent Invitation[]    @relation("SentBy")
  passwordResets  PasswordReset[]
  appointmentsAsClient       Appointment[] @relation("ClientAppointments")
  appointmentsAsProfessional Appointment[] @relation("ProfessionalAppointments")
  balancePaymentsCollected   Appointment[] @relation("BalanceCollectedBy")
  galleryPhotos              ClientGalleryPhoto[]
  notifications              ProfessionalNotification[]
  clientNotifications        ClientNotification[]
  productOrders              ProductOrder[]
  orders                     Order[]
  reviews                    Review[]
  specialEventsAsProfessional SpecialEvent[] @relation("SpecialEventProfessional")

  @@map("users")
}

model Professional {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  user            User     @relation(fields: [userId], references: [id])
  bio             String?
  photo           String?
  specialty       String?
  yearsExperience Int      @default(0) @map("years_experience")
  certifications  String?
  languages       String[] @default([])
  instagram       String?
  facebook        String?
  tiktok          String?
  twitter         String?
  policies        String?
  paymentMethods  String[] @default([]) @map("payment_methods")
  toleranceMinutes     Int?    @map("tolerance_minutes")
  latePenalty          String? @map("late_penalty") @db.Text
  cancellationPolicy   String? @map("cancellation_policy") @db.Text
  reschedulePolicy     String? @map("reschedule_policy") @db.Text
  depositPolicy        String? @map("deposit_policy") @db.Text
  priorRecommendations String? @map("prior_recommendations") @db.Text
  afterCare            String? @map("after_care") @db.Text
  commissionType  String   @default("earned") @map("commission_type") @db.VarChar(20)
  commissionPct   Int      @default(0) @map("commission_pct")
  vacationFrom    DateTime? @map("vacation_from") @db.Date
  vacationTo      DateTime? @map("vacation_to") @db.Date
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  services ProfessionalService[]

  availability ProfessionalAvailability[]

  @@map("professionals")
}

model ProfessionalAvailability {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  professionalId String       @map("professional_id") @db.Uuid
  professional   Professional @relation(fields: [professionalId], references: [id])
  dayOfWeek      Int          @map("day_of_week")
  startTime      String       @map("start_time")
  endTime        String       @map("end_time")
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz

  // Ya no es único por día — un profesional puede tener varios rangos el mismo
  // día (ej: 08–12 y 14–20 con un hueco al mediodía). syncAvailability borra y
  // recrea las filas de un día entero en cada guardado, así que solo hace
  // falta un índice normal, no una constraint de unicidad.
  @@index([professionalId, dayOfWeek])
  @@map("professional_availability")
}

model Invitation {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @db.VarChar(255)
  token     String   @unique @db.VarChar(255)
  used      Boolean  @default(false)
  sentById  String?  @map("sent_by_id") @db.Uuid
  sentBy    User?    @relation("SentBy", fields: [sentById], references: [id])
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  expiresAt DateTime @default(dbgenerated("NOW() + INTERVAL '7 days'")) @map("expires_at") @db.Timestamptz

  @@map("invitations")
}

model PasswordReset {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique @db.VarChar(255)
  used      Boolean  @default(false)
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("password_resets")
}

model Client {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @unique @map("user_id") @db.Uuid
  user        User      @relation(fields: [userId], references: [id])
  birthDate   DateTime? @map("birth_date") @db.Date
  allergies   String?   @db.Text
  preferences String?   @db.Text
  observations String?  @db.Text
  consents    String[]  @default([])
  loyaltyPoints Int     @default(0) @map("loyalty_points")
  notes       String?   @db.Text
  blocked     Boolean   @default(false)
  // Cooldown del job de recordatorio por inactividad — evita re-mandar el
  // mismo mail todos los días mientras el cliente sigue sin reservar.
  lastInactivityReminderAt DateTime? @map("last_inactivity_reminder_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@map("clients")
}

model ProfessionalService {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  professionalId String       @map("professional_id") @db.Uuid
  professional   Professional @relation(fields: [professionalId], references: [id])
  serviceId      String       @map("service_id") @db.Uuid
  service        Service      @relation(fields: [serviceId], references: [id])
  ownPrice       Decimal      @map("own_price") @db.Decimal(10, 2)
  ownDuration    Int          @map("own_duration")
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz

  @@unique([professionalId, serviceId])
  @@map("professional_services")
}

model Service {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.VarChar(150)
  categoryId  String   @map("category_id") @db.VarChar(50)
  description String   @db.Text
  duration    Int
  price       Decimal  @db.Decimal(10, 2)
  image       String?  @db.Text
  status      String   @default("active") @db.VarChar(20)
  isCombo     Boolean  @default(false) @map("is_combo")
  comboServiceIds String[] @default([]) @map("combo_service_ids")
  simultaneous    Boolean  @default(false)
  // Para un servicio simultáneo: qué profesionales puede elegir el cliente
  // para cada componente — { [componentServiceId]: professionalId[] }. Vacío
  // o sin entrada para un componente = cualquier profesional que haga ese
  // servicio (comportamiento previo, vía ProfessionalService).
  comboProfessionals Json @default("{}") @map("combo_professionals")
  // Servicio especial: un solo día fijo (specialDate), con horarios puntuales
  // (specialSlots) cada uno asignado a un profesional. duration/price de arriba
  // no se usan acá — el precio/duración reales salen de las zonas/paquetes que
  // el cliente elige al reservar.
  isSpecial    Boolean  @default(false) @map("is_special")
  specialDate  String?  @map("special_date") @db.VarChar(10)
  // [{ id, time, professionalId, professionalName, active, clientName?, appointmentId? }]
  specialSlots Json     @default("[]") @map("special_slots")
  // [{ id, name, duration, price, active }]
  zones        Json     @default("[]")
  // [{ id, name, zoneIds: [id], duration, price, active }]
  packages     Json     @default("[]")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  professionalServices ProfessionalService[]
  appointments         Appointment[]
  specialEvents        SpecialEvent[]

  @@map("services")
}

model Appointment {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId       String   @map("client_id") @db.Uuid
  client         User     @relation("ClientAppointments", fields: [clientId], references: [id])
  professionalId String   @map("professional_id") @db.Uuid
  professional   User     @relation("ProfessionalAppointments", fields: [professionalId], references: [id])
  serviceId      String   @map("service_id") @db.Uuid
  service        Service  @relation(fields: [serviceId], references: [id])
  date           String   @db.VarChar(10)
  time           String   @db.VarChar(5)
  duration       Int
  servicePrice   Decimal  @map("service_price") @db.Decimal(10, 2)
  depositAmount  Decimal  @default(0) @map("deposit_amount") @db.Decimal(10, 2)
  status         String   @default("pending") @db.VarChar(20)
  paymentStatus  String   @default("pending") @map("payment_status") @db.VarChar(20)
  // Id del pago en Mercado Pago que confirmó la seña — se completa recién
  // cuando llega el webhook, nunca antes. Sirve también de traza de auditoría.
  mpPaymentId    String?  @map("mp_payment_id") @db.VarChar(50)
  clientNotes    String?  @map("client_notes") @db.Text
  internalNotes  String?  @map("internal_notes") @db.Text
  allergies      String?  @db.Text
  accompanied    Boolean?
  companionName  String?  @map("companion_name") @db.VarChar(150)
  designType     String?  @map("design_type") @db.VarChar(10)
  designValue    String?  @map("design_value") @db.Text
  hasOtherSalonPolish     Boolean? @map("has_other_salon_polish")
  isNailReconstruction    Boolean? @map("is_nail_reconstruction")
  nailReconstructionCount Int?     @map("nail_reconstruction_count")
  hairLength              String?  @map("hair_length") @db.VarChar(20)
  wantsExtensions         Boolean? @map("wants_extensions")
  skinType                String?  @map("skin_type") @db.VarChar(20)
  comboGroupId   String?  @map("combo_group_id") @db.Uuid
  // Promoción de servicio (home) con la que se reservó, si la hubo — el precio
  // ya viene repriceado server-side a promotion.price al crear el turno (ver
  // resolveServicePromotion en appointment.service.ts), esto solo queda como
  // referencia para reportes (ej. tasa de conversión de promociones).
  promotionId    String?  @map("promotion_id") @db.Uuid
  promotion      Promotion? @relation(fields: [promotionId], references: [id])
  // Se prende cuando ADMIN o PROFESIONAL reprograman el turno (no cuando lo hace
  // el cliente — ahí ya sabe que cambió). El cliente lo ve como un aviso hasta
  // que confirma haberlo visto vía PATCH .../acknowledge-reschedule.
  rescheduleNoticePending Boolean  @default(false) @map("reschedule_notice_pending")
  previousDate            String?  @map("previous_date") @db.VarChar(10)
  previousTime            String?  @map("previous_time") @db.VarChar(5)
  // Servicios especiales — snapshot de las zonas/paquetes elegidos al reservar
  // ({name, price, duration}), así una edición posterior de la zona/paquete no
  // cambia retroactivamente turnos ya reservados.
  selectedZones    Json  @default("[]") @map("selected_zones")
  selectedPackages Json  @default("[]") @map("selected_packages")
  // El cliente contestó "ahora no" al pedido de reseña — no se le vuelve a
  // preguntar por este turno puntual.
  reviewDismissed Boolean  @default(false) @map("review_dismissed")
  review          Review?
  cancelledAt    DateTime? @map("cancelled_at") @db.Timestamptz
  // 'user_cancelled' (lo canceló el cliente/admin/profesional) | 'unpaid_expired'
  // (se liberó solo porque nunca se pagó la seña) — para mostrarle al cliente un
  // mensaje distinto de "cancelado" cuando en realidad nunca llegó a confirmarse.
  cancelReason   String?   @map("cancel_reason") @db.VarChar(30)
  // Se completa cuando la clienta (o el profesional/admin en su nombre) registra
  // que llegó al local. Si un turno 'confirmed' sigue en null 20 minutos después
  // de la hora pactada, el job autoNoShow.job.ts lo marca 'no_show' solo.
  arrivedAt      DateTime? @map("arrived_at") @db.Timestamptz
  // Cobro del SALDO restante (precio - seña) en el local — la seña ya se
  // cobra sola por Mercado Pago (mpPaymentId), pero el resto se paga en mano
  // al momento del servicio y hasta ahora no quedaba ningún registro. 'cash' |
  // 'transfer' | 'card' | 'other'. Al completarse, paymentStatus pasa a 'paid'
  // si con esto se cubre el precio total (ver registerBalancePayment).
  balancePaymentMethod String?   @map("balance_payment_method") @db.VarChar(20)
  balancePaidAmount     Decimal?  @map("balance_paid_amount") @db.Decimal(10, 2)
  balancePaidAt         DateTime? @map("balance_paid_at") @db.Timestamptz
  // Quién lo cobró/registró — para poder rendir cuentas de efectivo recibido
  // en mano por cada profesional, no para saber "a quién" se le pagó (eso ya
  // es la clienta del turno).
  balanceCollectedById  String?   @map("balance_collected_by_id") @db.Uuid
  balanceCollectedBy    User?     @relation("BalanceCollectedBy", fields: [balanceCollectedById], references: [id])
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Evita doble reserva: un mismo profesional no puede tener dos turnos activos
  // (ni cancelled ni no_show) en la misma fecha/hora. Se implementa como un índice
  // único PARCIAL creado a mano en la migración — Prisma
  // no puede expresar ese WHERE en el schema, así que intencionalmente no hay
  // ningún @@unique/@@index acá para esas columnas (evita que `migrate diff`
  // intente crear un índice plano redundante). Ver migración add_no_double_booking.
  @@map("appointments")
}

model Product {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.VarChar(150)
  brand       String   @default("") @db.VarChar(100)
  category    String   @default("") @db.VarChar(50)
  description String   @default("") @db.Text
  imageUrl    String?  @map("image_url") @db.Text
  price       Decimal  @db.Decimal(10, 2)
  stock       Int      @default(0)
  minStock    Int      @default(0) @map("min_stock")
  status      String   @default("active") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  orders    ProductOrder[]
  movements InventoryMovement[]

  @@map("products")
}

// Ledger de entradas/salidas de stock — cada movimiento ajusta Product.stock
// al crearse/editarse/borrarse (ver inventoryMovement.model.ts).
model InventoryMovement {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  product     Product  @relation(fields: [productId], references: [id])
  // Snapshot del nombre al momento del movimiento — si el producto se
  // renombra después, el historial no cambia retroactivamente.
  productName String   @map("product_name") @db.VarChar(150)
  type        String   @db.VarChar(10) // 'entry' | 'exit'
  quantity    Int
  note        String   @default("") @db.Text
  date        String   @db.VarChar(10) // YYYY-MM-DD
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("inventory_movements")
}

// Un pedido de tienda — puede tener varios productos (items) y datos de entrega.
model Order {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId        String   @map("client_id") @db.Uuid
  client          User     @relation(fields: [clientId], references: [id])
  deliveryType    String   @map("delivery_type") @db.VarChar(20)
  deliveryAddress String?  @map("delivery_address") @db.Text
  phone           String?  @db.VarChar(30)
  notes           String?  @db.Text
  paymentMethod   String?  @map("payment_method") @db.VarChar(20)
  totalPrice      Decimal  @map("total_price") @db.Decimal(10, 2)
  // 'pending' | 'confirmed' | 'ready' | 'delivered' | 'cancelled' — sin gestión
  // de admin todavía, así que por ahora queda en 'pending' desde que se crea.
  status          String   @default("pending") @db.VarChar(20)
  // Separado de `status` (que es de logística): 'pending' | 'paid' | 'rejected'.
  // Se actualiza únicamente desde el webhook de Mercado Pago, nunca antes.
  paymentStatus   String   @default("pending") @map("payment_status") @db.VarChar(20)
  mpPaymentId     String?  @map("mp_payment_id") @db.VarChar(50)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  items ProductOrder[]

  @@map("orders")
}

// Línea de un pedido — un producto + cantidad dentro de un Order.
model ProductOrder {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId    String   @map("order_id") @db.Uuid
  order      Order    @relation(fields: [orderId], references: [id])
  clientId   String   @map("client_id") @db.Uuid
  client     User     @relation(fields: [clientId], references: [id])
  productId  String   @map("product_id") @db.Uuid
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int
  unitPrice  Decimal  @map("unit_price") @db.Decimal(10, 2)
  totalPrice Decimal  @map("total_price") @db.Decimal(10, 2)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("product_orders")
}

// Campaña automática (cumpleaños, turno N, etc.) — a diferencia de Promotion,
// NUNCA se muestra en el home: es una regla que el admin prende/apaga y que un
// job diario evalúa por cliente, mandando un mail con el descuento si aplica.
model AutoPromotion {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String   @db.VarChar(150)
  // 'birthday' | 'appointment_milestone' — más triggers se agregan acá.
  trigger       String   @db.VarChar(30)
  // birthday: {"daysBefore": 3} — cuántos días antes del cumpleaños se manda.
  // appointment_milestone: {"count": 100} — a qué turno número (del cliente) dispara.
  triggerConfig Json     @default("{}") @map("trigger_config")
  discountType  String   @db.VarChar(10) @map("discount_type") // 'percent' | 'fixed'
  discountValue Decimal  @db.Decimal(10, 2) @map("discount_value")
  // Texto libre opcional que se suma al mail (además del descuento).
  message       String   @default("") @db.Text
  // A quién aplica: 'all' (todos los clientes activos), 'manual' (los elegidos
  // a mano en audienceClientIds) o 'category' (clientes con algún turno alguna
  // vez en audienceCategoryId).
  audienceType       String   @default("all") @db.VarChar(20) @map("audience_type")
  audienceClientIds  String[] @default([]) @map("audience_client_ids") @db.Uuid
  audienceCategoryId String?  @db.VarChar(50) @map("audience_category_id")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  sends AutoPromotionSend[]

  @@map("auto_promotions")
}

// Registro de a quién ya se le mandó cada campaña, para no repetir el mismo
// envío (el cumpleaños vuelve cada año, el turno-N es una sola vez).
model AutoPromotionSend {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  autoPromotionId String        @map("auto_promotion_id") @db.Uuid
  autoPromotion   AutoPromotion @relation(fields: [autoPromotionId], references: [id], onDelete: Cascade)
  clientId        String        @map("client_id") @db.Uuid
  // 'birthday' -> año ("2026"); 'appointment_milestone' -> "once".
  periodKey       String        @db.VarChar(20) @map("period_key")
  sentAt          DateTime      @default(now()) @map("sent_at") @db.Timestamptz

  @@unique([autoPromotionId, clientId, periodKey])
  @@map("auto_promotion_sends")
}

model Promotion {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type          String   @db.VarChar(20)
  // discount: un ítem real a precio promocional. bundle: 2+ ítems reales combo.
  // buy_x_pay_y: un ítem real, oferta "llevás X, pagás Y".
  kind          String   @default("discount") @db.VarChar(20)
  title         String   @db.VarChar(150)
  description   String   @default("") @db.Text
  image         String?  @db.Text
  price         Decimal  @db.Decimal(10, 2)
  originalPrice Decimal? @map("original_price") @db.Decimal(10, 2)
  status        String   @default("active") @db.VarChar(20)
  // Servicios o productos reales a los que aplica — [{id, name, price}], snapshot
  // tomado del catálogo al armar la promo, no una relación en vivo.
  items         Json     @default("[]")
  // Solo para kind: 'buy_x_pay_y' — ej. buyQty:3, payQty:2 = "3x2".
  buyQty        Int?     @map("buy_qty")
  payQty        Int?     @map("pay_qty")
  // Ventana de vigencia (YYYY-MM-DD, mismo formato que Appointment.date) — fuera
  // de este rango la promo no debe aparecer en /api/promotions/public.
  startDate     String?  @map("start_date") @db.VarChar(10)
  endDate       String?  @map("end_date") @db.VarChar(10)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  appointments  Appointment[]

  @@map("promotions")
}

// Evento especial destacado en el home (ej: jornada de Depilación definitiva
// con una profesional puntual) — el admin lo activa/desactiva, y el cliente
// que toca "Reservar" entra al wizard con servicio + profesional + fecha ya
// elegidos, solo falta el horario (ver DateTimeStep con dateLocked).
model SpecialEvent {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceId      String   @map("service_id") @db.Uuid
  service        Service  @relation(fields: [serviceId], references: [id])
  professionalId String   @map("professional_id") @db.Uuid
  professional   User     @relation("SpecialEventProfessional", fields: [professionalId], references: [id])
  date           String   @db.VarChar(10)
  title          String?  @db.VarChar(150)
  description    String?  @db.Text
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("special_events")
}

// Fila única — configuración de seña, cancelaciones y reembolsos
model PaymentSettings {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  depositAmount     Decimal @default(5000) @map("deposit_amount") @db.Decimal(10, 2)
  depositPercent    Boolean @default(false) @map("deposit_percent")
  cancellationHours Int     @default(24) @map("cancellation_hours")
  refundPolicy      String  @default("full") @map("refund_policy") @db.VarChar(20)

  @@map("payment_settings")
}

// Fila única — datos generales del negocio (nombre, contacto, redes, políticas)
model BusinessSettings {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @default("") @db.VarChar(150)
  logo        String?  @db.Text
  description String   @default("") @db.Text
  address     String   @default("") @db.VarChar(255)
  phone       String   @default("") @db.VarChar(30)
  email       String   @default("") @db.VarChar(255)
  instagram   String?  @db.VarChar(255)
  facebook    String?  @db.VarChar(255)
  tiktok      String?  @db.VarChar(255)
  twitter     String?  @db.VarChar(255)
  whatsapp    String?  @db.VarChar(30)
  policies    String[] @default([])
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("business_settings")
}

// Horario semanal de atención — una fila por día
model BusinessScheduleDay {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  day       String  @unique @db.VarChar(20)
  isOpen    Boolean @default(false) @map("is_open")
  openTime  String  @default("09:00") @map("open_time") @db.VarChar(5)
  closeTime String  @default("18:00") @map("close_time") @db.VarChar(5)

  @@map("business_schedule_days")
}

model BusinessHoliday {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date        String   @db.VarChar(10)
  description String   @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("business_holidays")
}

model ClientGalleryPhoto {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId   String   @map("client_id") @db.Uuid
  client     User     @relation(fields: [clientId], references: [id])
  url        String   @db.Text
  category   String   @db.VarChar(10)
  showOnHome Boolean  @default(false) @map("show_on_home")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("client_gallery_photos")
}

model ActivityLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userName  String   @default("Sistema") @map("user_name") @db.VarChar(100)
  action    String   @db.VarChar(255)
  module    String   @db.VarChar(30)
  level     String   @default("info") @db.VarChar(20)
  detail    String?  @db.Text
  // Referencia suelta (sin FK formal) a la reseña que originó este log, para
  // poder aprobar/rechazar el comentario desde Actividad. El estado se lee en
  // vivo de Review.status en el momento de listar, no se duplica acá.
  reviewId  String?  @map("review_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("activity_logs")
}

model Review {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId      String   @map("client_id") @db.Uuid
  client        User     @relation(fields: [clientId], references: [id])
  appointmentId String   @unique @map("appointment_id") @db.Uuid
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  rating        Int
  message       String?  @db.Text
  // El rating siempre cuenta para el promedio público apenas se crea. El
  // status acá es sobre la moderación del MENSAJE: sin mensaje no hay nada
  // que aprobar, así que nace 'approved' directamente; con mensaje nace
  // 'pending' hasta que el admin lo revisa desde Actividad.
  status        String   @default("approved") @db.VarChar(20)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("reviews")
}

model ProfessionalNotification {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  professionalId String   @map("professional_id") @db.Uuid
  professional   User     @relation(fields: [professionalId], references: [id])
  type           String   @db.VarChar(30)
  title          String   @db.VarChar(255)
  body           String   @db.Text
  read           Boolean  @default(false)
  link           String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("professional_notifications")
}

model ClientNotification {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  client    User     @relation(fields: [clientId], references: [id])
  type      String   @db.VarChar(30)
  title     String   @db.VarChar(255)
  body      String   @db.Text
  read      Boolean  @default(false)
  link      String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("client_notifications")
}

// Estado del árbol conversacional de WhatsApp por número de teléfono.
// Una fila por cliente en conversación con el bot.
model ConversacionWhatsapp {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  telefono     String   @unique @db.VarChar(20)
  estadoActual String   @default("inicio") @map("estado_actual") @db.VarChar(50)
  contexto     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("conversaciones_whatsapp")
}

// Registro de mensajes ya procesados (idempotencia, RNF-10) — evita
// procesar dos veces el mismo mensaje si Meta reintenta la entrega del webhook.
model MensajeWhatsappProcesado {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wamid     String   @unique @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("mensajes_whatsapp_procesados")
}