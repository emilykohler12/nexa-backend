{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.test)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/block-protected-files.mjs" },
          { "type": "command", "command": "node .claude/hooks/warn-secrets.mjs" }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/guard-bash.mjs" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/typecheck-after-edit.mjs", "timeout": 130 }
        ]
      }
    ]
  }
}
