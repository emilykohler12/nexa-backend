# Copiar este archivo como .env y completar DATABASE_URL.
# El resto de los valores sirven tal cual para desarrollo local.
# Están todas las variables que lee el backend: las de src/app/config/env.ts (validadas con zod; si
# falta una obligatoria el proceso termina con exit(1)) más SENTRY_DSN, que lee src/sentry.ts.
# No definir TZ: el servidor tiene que correr en UTC (ver «Hora de Argentina» en CLAUDE.md).

# Entorno: development | production | test (por defecto development)
NODE_ENV=development

# Base de datos — reemplazar usuario y contraseña por los de tu PostgreSQL local
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nexa_dev"

# Puerto del backend — el frontend apunta acá (VITE_API_URL en nexa-frontend). Por defecto 4000.
PORT=4000

# JWT (mínimo 32 caracteres cada secreto). Duraciones en el formato de jsonwebtoken;
# si se borran las líneas valen 15m y 7d (no dejarlas vacías: un valor vacío no toma el valor por defecto).
JWT_SECRET="tu_jwt_secret_super_largo_aqui_minimo_32_caracteres"
JWT_REFRESH_SECRET="tu_refresh_secret_distinto_aqui_minimo_32_caracteres"
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# URL del frontend (CORS, control de Origin, links en mails y vuelta de Mercado Pago)
FRONTEND_URL="http://localhost:5173"

# Admin inicial — se crea solo al arrancar el backend si no existe
ADMIN_EMAIL="admin@nexa.local"
ADMIN_PASSWORD="Admin1234!"
ADMIN_NAME="Admin"

# ── Opcionales: la app arranca y el caso de uso vertical funciona sin ellas ──

# Mercado Pago (pago online de la seña y de los pedidos).
# MERCADOPAGO_WEBHOOK_SECRET firma los avisos: sin ella el webhook responde 500 y ningún pago se confirma solo.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# URL pública del backend a la que Mercado Pago manda los avisos (/api/webhook/mercadopago).
# En desarrollo, la de un túnel; vacía = no se pide aviso y el pago no se confirma solo.
BACKEND_PUBLIC_URL=

# Sentry (monitoreo de errores; no se inicia con NODE_ENV=test)
SENTRY_DSN=

# Supabase Storage (subida de imágenes)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Mails. En producción (Render) se envían por la API de Brevo: el SMTP está bloqueado en el plan gratis.
# BREVO_API_KEY va solo en Render (Environment), nunca en el repositorio. Sin ella se usa SMTP (desarrollo).
# MAIL_FROM es el remitente de todos los mails y tiene que estar verificado en Brevo.
MAIL_FROM="kologic6@gmail.com"
BREVO_API_KEY=""
# Solo para desarrollo con SMTP (sin BREVO_API_KEY):
MAIL_HOST="smtp.gmail.com"
MAIL_PORT="587"
MAIL_USER=""
MAIL_PASS=""
