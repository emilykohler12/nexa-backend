MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# WhatsApp Cloud API (Meta) — opcionales, solo necesarias para el webhook
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Login social — opcionales, solo necesarias para /api/auth/social-login.
# Mismo valor que VITE_GOOGLE_CLIENT_ID / VITE_FACEBOOK_APP_ID del frontend.
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=

# Mercado Pago — opcionales, solo necesarias para pagos reales
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
BACKEND_PUBLIC_URL=